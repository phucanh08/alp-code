# Tài liệu identity sinh bởi `alp identity sync` từ registry trong src/agents/. Nguồn sự
# thật là code; đây chỉ là cache phẳng để hook SessionStart đọc nhanh, không cần load dist/.
/.alp/

# Session state ở gốc repo — sinh ra khi mở `claude` trần trong một checkout alp-code
# (dev clone). Scratch cục bộ của từng máy.
/.claude/session-state/

# Trí nhớ là dữ liệu CỤC BỘ của từng máy — không bao giờ đẩy lên remote.
# Đồng bộ giữa máy sẽ do Agent runtime lo, không phải git.
# Khung rỗng để dựng lại `memory/` trên máy mới nằm ở `scaffold/memory/` (tracked),
# `scripts/bootstrap.cjs` chép sang những file còn thiếu — không bao giờ đè file đã có.
/memory/

.DS_Store

# Worktree cục bộ cho các nhánh triển khai cô lập.
.worktrees/

# TypeScript build output.
dist/

# Installed Node.js dependencies.
node_modules/
